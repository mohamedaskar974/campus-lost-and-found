{
  "version": 2,
  "buildCommand": "echo 'Build complete'",
  "functions": {
    "server.js": {
      "includeFiles": "index.html"
    },
    "api/index.js": {
      "includeFiles": "index.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ]
}
