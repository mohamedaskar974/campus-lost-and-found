{
  "version": 2,
  "buildCommand": "echo 'Build complete'",
  "functions": {
    "server.js": {
      "includeFiles": "index.html"
    },
    "api/**/*.js": {
      "includeFiles": "index.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/items/(.*)/claim",
      "destination": "/server.js"
    },
    {
      "source": "/api/items",
      "destination": "/api/items.js"
    },
    {
      "source": "/api/metrics",
      "destination": "/api/metrics.js"
    },
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ]
}
